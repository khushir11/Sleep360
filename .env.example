# Copy to .env for local development. Never commit .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# development | production
APP_ENV=development

# Optional. Defaults to SQLite at instance/sleep360.db. Use Postgres in production:
# DATABASE_URL=postgresql://user:password@host:5432/sleep360
DATABASE_URL=

# Optional: enables the Claude-powered assistant. Without it, the built-in guide answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: shared rate-limit storage for multi-worker deployments
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Set to 0 only for local HTTP development (cookies are Secure by default)
SESSION_COOKIE_SECURE=1
